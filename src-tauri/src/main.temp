#[tauri::command]
fn get_project(state: State<AppState>) -> Result<Project, String> {
    let db_lock = state.db.lock().map_err(|e| e.to_string())?;
    let conn = db_lock.as_ref().ok_or("Database not open")?;
    database::get_project(conn).map_err(|e| e.to_string())
}

