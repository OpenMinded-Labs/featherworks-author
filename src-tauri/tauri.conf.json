{
	"build": {
		"devPath": "http://localhost:5173",
		"distDir": "../dist"
	},
	"package": {
		"productName": "featherworks_author",
		"version": "0.1.0"
	},
	"tauri": {
		"allowlist": {
			"all": false,
			"dialog": {
				"open": true,
				"save": true,
				"message": true,
				"confirm": true,
				"ask": true
			},
			"fs": {
				"readFile": true,
				"writeFile": true,
				"exists": true,
				"scope": ["$CACHE/*", "$CACHE/**", "$APP/*", "$APP/**", "$HOME/**", "$DOCUMENT/**", "$DESKTOP/**", "$TEMP/**"]
			},
			"path": {
				"all": true
			},
			"window": {
				"all": true
			}
		},
		"bundle": {
			"identifier": "com.featherworks.author",
			"icon": [
				"icons/32x32.png",
				"icons/128x128.png",
				"icons/256x256.png",
				"icons/512x512.png"
			],
			"resources": [
				"resources/models",
				"resources/dictionaries"
			]
		},
		"updater": {
			"active": false
		},
		"windows": [
			{
				"label": "main",
				"title": "Featherworks Author",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			},
			{
				"label": "preview",
				"title": "Layout-Vorschau",
				"width": 1100,
				"height": 850,
				"resizable": true,
				"fullscreen": false,
				"visible": false,
				"decorations": true,
				"alwaysOnTop": false,
				"skipTaskbar": false,
				"url": "index.html#/preview",
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	}
}